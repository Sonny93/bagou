<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title data-inertia>Bagou</title>
  <meta name="description" content="Real-time voice dictation">
  <meta name="theme-color" content="#f3f6f8" data-light="#f3f6f8" data-dark="#131b21">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
  <link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">

  <script>{{{ themeInitScript }}}</script>

  @viteReactRefresh()
  @inertiaHead()
  @vite(['inertia/app.tsx', `inertia/pages/${page.component}.tsx`])
</head>

<body>
  @inertia()
</body>

</html>

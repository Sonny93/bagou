<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title data-inertia>Bagou</title>
  <meta name="description" content="Real-time voice dictation">
  <meta name="theme-color" content="#f3f6f8">
  <link rel="manifest" href="/manifest.webmanifest">
  <link rel="icon" href="/icons/icon.svg" type="image/svg+xml">
  <link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">

  <script>
    (function () {
      var storedTheme = null;
      try {
        storedTheme = localStorage.getItem('theme');
      } catch (error) {}
      var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      var isDark = storedTheme === 'dark' || (storedTheme !== 'light' && prefersDark);
      document.documentElement.classList.toggle('dark', isDark);
      document
        .querySelector('meta[name="theme-color"]')
        .setAttribute('content', isDark ? '#131b21' : '#f3f6f8');
    })();
  </script>

  @viteReactRefresh()
  @inertiaHead()
  @vite(['inertia/app.tsx', `inertia/pages/${page.component}.tsx`])
</head>

<body>
  @inertia()
</body>

</html>

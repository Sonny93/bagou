# App
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=debug
APP_KEY=
NODE_ENV=development

# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=root
DB_PASSWORD=root
DB_DATABASE=bagou

# App url
APP_URL=http://localhost:3333

# Speech-to-text provider for the whole instance: mistral or deepgram

{
	"typescript.preferences.importModuleSpecifier": "non-relative",
	/* Prefer tabs over spaces for accessibility */
	"editor.insertSpaces": false,
	"editor.detectIndentation": false,
	"oxc.typeAware": true,
	"editor.defaultFormatter": "oxc.oxc-vscode",
	/* Explorer */
	"explorer.fileNesting.enabled": true,
	"explorer.fileNesting.patterns": {
		"*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
		"package.json": "pnpm-lock.yaml, tsconfig.json, oxlint.config.ts, oxfmt.config.ts, knip.ts, vite.config.ts, uno.config.ts, .editorconfig",
		"Justfile": "*compose.yml, Dockerfile, .dockerignore"
	}
}

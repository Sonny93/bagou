{
	"$schema": "https://unpkg.com/release-it@21/schema/release-it.json",
	"hooks": {
		"before:init": "node scripts/check_changelog_twin.ts",
		"before:git:release": "node scripts/roll_french_changelog.ts ${version} && git add CHANGELOG.fr.md"
	},
	"git": {
		"requireCleanWorkingDir": true,
		"commitMessage": "chore: release v${version}",
		"tagName": "v${version}",
		"commit": true,
		"tag": true,
		"push": false
	},
	"github": {
		"release": false
	},
	"npm": {
		"publish": false
	},
	"plugins": {
		"@release-it/keep-a-changelog": {
			"filename": "CHANGELOG.md",
			"addUnreleased": true,
			"addVersionUrl": true
		}
	}
}

{
	"name": "bagou",
	"version": "1.0.1",
	"private": true,
	"license": "MIT",
	"author": {
		"name": "Sonny",
		"email": "sonnyasdev@gmail.com",
		"url": "https://www.sonny.dev/"
	},
	"type": "module",
	"imports": {
		"#client/*": "./.adonisjs/client/*.ts",
		"#generated/*": "./.adonisjs/server/*.js",
		"#app/*": "./app/*.js",
		"#dictation/*": "./app/dictation/*.js",
		"#dictation_quota/*": "./app/dictation_quota/*.js",
		"#shared/*": "./app/shared/*.js",
		"#transcription_history/*": "./app/transcription_history/*.js",
		"#transcription/*": "./app/transcription/*.js",
		"#text_cleanup/*": "./app/text_cleanup/*.js",
		"#stt_bench/*": "./app/stt_bench/*.js",
		"#auth/*": "./app/auth/*.js",
		"#passkeys/*": "./app/passkeys/*.js",
		"#user_settings/*": "./app/user_settings/*.js",
		"#users/*": "./app/users/*.js",
		"#exceptions/*": "./app/exceptions/*.js",
		"#middleware/*": "./app/middleware/*.js",
		"#providers/*": "./providers/*.js",
		"#database/*": "./database/*.js",
		"#tests/*": "./tests/*.js",
		"#start/*": "./start/*.js",
		"#config/*": "./config/*.js"
	},
	"scripts": {
		"start": "node bin/server.js",
		"build": "node ace build --tsconfig tsconfig.build.json",
		"dev": "node ace serve --hmr",
		"test": "node ace test",
		"test:front": "vitest run",
		"i18n:extract": "lingui extract --clean",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"format": "oxfmt && oxlint --fix",
		"format:check": "oxfmt --check",
		"typecheck": "tsc --noEmit && tsc --noEmit --project inertia/tsconfig.json",
		"knip": "knip",
		"check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run knip && pnpm run test && pnpm run test:front",
		"release": "release-it"
	},
	"dependencies": {
		"@adonisjs/auth": "^10.1.0",
		"@adonisjs/core": "^7.6.0",
		"@adonisjs/cors": "^3.0.0",
		"@adonisjs/inertia": "^5.0.5",
		"@adonisjs/limiter": "^3.0.1",
		"@adonisjs/lucid": "^22.4.2",
		"@adonisjs/session": "^8.3.0",
		"@adonisjs/shield": "^9.0.0",
		"@adonisjs/static": "^2.0.1",
		"@adonisjs/vite": "^6.0.4",
		"@anthropic-ai/sdk": "^1.3.0",
		"@inertiajs/react": "^3.9.1",
		"@lingui/core": "^6.10.1",
		"@lingui/react": "^6.10.1",
		"@minimalstuff/ui": "^4.3.2",
		"@rlanz/socket": "^0.2.4",
		"@simplewebauthn/browser": "14.0.0",
		"@simplewebauthn/server": "14.0.3",
		"@tuyau/core": "^1.2.3",
		"@vinejs/vine": "^4.4.0",
		"clsx": "^2.1.1",
		"edge.js": "^6.5.1",
		"luxon": "^3.7.2",
		"pg": "^8.23.1",
		"proxy-addr": "^2.0.8",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"reflect-metadata": "^0.2.2",
		"sonner": "^2.0.8"
	},
	"devDependencies": {
		"@adonisjs/assembler": "^8.6.0",
		"@adonisjs/tsconfig": "^2.0.0",
		"@iconify-json/tabler": "^1.2.42",
		"@japa/api-client": "^3.2.1",
		"@japa/assert": "^4.2.0",
		"@japa/plugin-adonisjs": "^5.2.0",
		"@japa/runner": "^5.4.0",
		"@lingui/cli": "^6.10.1",
		"@lingui/swc-plugin": "^6.7.1",
		"@lingui/vite-plugin": "^6.10.1",
		"@minimalstuff/tooling": "^0.7.0",
		"@poppinss/ts-exec": "^1.5.1",
		"@release-it/keep-a-changelog": "^8.0.1",
		"@types/luxon": "^3.7.6",
		"@types/node": "^26.6.5",
		"@types/proxy-addr": "^2.0.3",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@unocss/preset-icons": "^66.11.0",
		"@unocss/preset-web-fonts": "66.11.0",
		"@vitejs/plugin-react-swc": "^4.3.3",
		"hot-hook": "^1.0.0",
		"knip": "^6.42.1",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2005",
		"pino-pretty": "^13.2.0",
		"release-it": "^21.1.1",
		"typescript": "~6.0.3",
		"unocss": "^66.11.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"youch": "^4.1.1"
	},
	"packageManager": "pnpm@12.15.0",
	"hotHook": {
		"boundaries": [
			"./app/**/*_controller.ts",
			"./app/middleware/*.ts"
		]
	}
}
